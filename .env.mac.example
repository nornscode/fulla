# The Mac worker (`uv run --env-file .env.mac fulla-mac`). Nothing else reads this.

# The hosted Norns runtime, by its public URL, and the same key the Fly app uses.
NORNS_URL=https://your-norns.example.com
NORNS_API_KEY=

# Apps AppleScript may address. Default: Things3,Reminders,Notes,Calendar,Messages
# FULLA_MAC_APPS=Things3,Reminders,Notes,Calendar,Messages

# Who Fulla may iMessage, as Name=handle pairs. Empty means sending is off.
# FULLA_IMESSAGE_ALLOW=Jane=+16475550100,Mom=mom@icloud.com

# Default list for mac_reminders_create.
# FULLA_REMINDERS_LIST=Reminders

# tmux sessions Fulla may read and type into, by name, or * for all of them.
# Typing into a shell runs commands, so this is empty (off) by default.
# FULLA_TMUX_SESSIONS=work,scratch

# The Fly app, so the worker can announce itself (which tmux sessions it allows).
# FULLA_URL=https://fulla.fly.dev

# The Shortcuts folder whose shortcuts Fulla may run for home automation
# (HomeKit scenes, lights, thermostat). Default: Fulla Home
# FULLA_MAC_HOME_FOLDER=Fulla Home
