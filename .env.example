# Telegram: token from @BotFather, user id from @userinfobot
FULLA_TELEGRAM_BOT_TOKEN=
FULLA_TELEGRAM_USER_ID=

# Norns
NORNS_URL=http://localhost:4001
NORNS_API_KEY=

# LLM (read by LiteLLM inside the SDK)
ANTHROPIC_API_KEY=

# From fulla-register-channel (the run webhook's secret)
NORNS_WEBHOOK_SECRET=
# From fulla-register (production only)
# NORNS_WAKE_SECRET=

# Optional
# FULLA_OWNER_NAME=Robin   # what she calls you in her prompts; "the owner" if unset
# FULLA_CALENDARS=Personal=https://calendar.google.com/calendar/ical/.../basic.ics,Work=https://...
# FULLA_TIMEZONE=America/Toronto
# FULLA_DATA_DIR=./data
# FULLA_MODEL=claude-opus-5-5
# BRAVE_API_KEY=   # web search, https://brave.com/search/api/

# Signal beside Telegram, or instead of it (see docs/messengers.md). The number
# is Fulla's, the owner is yours; the API is the signal-cli machine
# (deploy/signal/). FULLA_CHANNEL names the primary: where the morning brief
# and reminders go, and the key of the standing conversation.
# FULLA_CHANNEL=signal
# FULLA_SIGNAL_NUMBER=+16475550199
# FULLA_SIGNAL_OWNER=+16475550100
# FULLA_SIGNAL_URL=http://localhost:8080
# Answers a day in any one friend's chat or group (docs/friends-and-groups.md).
# FULLA_SOCIAL_DAILY_CAP=50

# Text messages through Twilio (docs/messengers.md). All four or none. The
# number can be the Signal one. FULLA_CHANNEL=sms makes texts the primary.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# FULLA_SMS_NUMBER=+16475550199
# FULLA_SMS_OWNER=+16475550100
