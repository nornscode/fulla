# A host worker (`uv run --env-file .env.host fulla-host`): any machine besides
# the Mac whose tmux sessions Fulla may reach. Nothing else reads this.

# The hosted Norns runtime, by its public URL, and the same key the Fly app uses.
NORNS_URL=https://your-norns.example.com
NORNS_API_KEY=
FULLA_URL=https://fulla.fly.dev

# This machine's name: lowercase letters and digits. Its tools are served as
# <name>_tmux_list, <name>_tmux_read and <name>_tmux_send. Fulla learns the
# machine exists when the worker announces itself to FULLA_URL on start.
FULLA_HOST=box

# tmux sessions Fulla may read and type into, by name, or * for all of them.
# Typing into a shell runs commands, so this is empty (off) by default.
# FULLA_TMUX_SESSIONS=work,scratch
